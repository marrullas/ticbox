---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="portfolio-card">
  <div class="portfolio-shot">
    <Image
      src={project.image}
      alt={project.imageAlt}
      widths={[480, 720, 960, 1200]}
      sizes="(max-width: 760px) 100vw, 560px"
      format="webp"
      quality={82}
      loading="lazy"
      decoding="async"
    />
  </div>

  <div class="portfolio-body">
    <div class="portfolio-meta">{project.number} / {project.category}</div>
    <h3>{project.title}</h3>
    <p>{project.description}</p>

    <div class="portfolio-tags">
      {project.tags.map((tag) => <span>{tag}</span>)}
    </div>

    {project.href && (
      <a
        class="portfolio-link"
        href={project.href}
        target="_blank"
        rel="noopener noreferrer"
      >
        {project.linkLabel ?? 'Visitar proyecto'}
        <span class="arrow" aria-hidden="true">↗</span>
      </a>
    )}

    {project.note && <span class="portfolio-note">{project.note}</span>}
  </div>
</article>
