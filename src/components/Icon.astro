---
interface Props {
  name: 'code' | 'ai' | 'automation' | 'consulting';
}

const { name } = Astro.props;
---

<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
  {name === 'code' && (
    <>
      <path d="m8.5 7-5 5 5 5" />
      <path d="m15.5 7 5 5-5 5" />
    </>
  )}
  {name === 'ai' && (
    <>
      <path d="M12 2.5v4" />
      <path d="M12 17.5v4" />
      <path d="M2.5 12h4" />
      <path d="M17.5 12h4" />
      <path d="m5.3 5.3 2.8 2.8" />
      <path d="m15.9 15.9 2.8 2.8" />
      <path d="m18.7 5.3-2.8 2.8" />
      <path d="m8.1 15.9-2.8 2.8" />
    </>
  )}
  {name === 'automation' && (
    <>
      <path d="M20.5 12a8.5 8.5 0 1 1-2.8-6.3" />
      <path d="M20.5 3.5V9H15" />
    </>
  )}
  {name === 'consulting' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="m15.6 8.4-2 5.2-5.2 2 2-5.2z" />
    </>
  )}
</svg>
