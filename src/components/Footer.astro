---
import { NAV, SITE } from '../data/site';
---

<footer class="site-footer">
  <div class="wrap">
    <div class="foot-grid">
      <div class="foot-brand">
        <a class="logo" href="/#inicio" aria-label="TICBOX, ir al inicio">
          TIC<b>BOX</b><span class="logo-dot" aria-hidden="true"></span>
        </a>
        <p>
          Software, integración de sistemas e inteligencia artificial aplicada para resolver
          problemas reales.
        </p>
      </div>

      <div class="foot-col">
        <h3>Secciones</h3>
        <ul>
          {NAV.map((item) => (
            <li><a href={`/${item.href}`}>{item.label}</a></li>
          ))}
        </ul>
      </div>

      <div class="foot-col">
        <h3>Contacto</h3>
        <ul>
          <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
          <li><a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a></li>
          <li><a href={SITE.youtube} target="_blank" rel="noopener noreferrer">YouTube ↗</a></li>
          <li><a href={SITE.github} target="_blank" rel="noopener noreferrer">Código en GitHub ↗</a></li>
        </ul>
      </div>
    </div>

    <div class="foot-bottom">
      <span>© <span id="year">2026</span> TICBOX · {SITE.tagline}</span>
      <span>Hecho en {SITE.location}</span>
    </div>
  </div>
</footer>

<script>
  const year = document.getElementById('year');
  if (year) year.textContent = String(new Date().getFullYear());
</script>
